  after_data    Json?
  ip_address    String?  @db.Inet
  user_agent    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         User?    @relation(fields: [admin_user_id], references: [id], onUpdate: NoAction)

  @@index([admin_user_id], map: "idx_admin_audit_logs_admin_user_id")
  @@index([created_at], map: "idx_admin_audit_logs_created_at")
