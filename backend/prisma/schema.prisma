generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                                                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName                                              String                @map("full_name") @db.VarChar(150)
  email                                                 String                @unique @db.VarChar(255)
  phone                                                 String?               @db.VarChar(30)
  passwordHash                                          String                @map("password_hash")
  role                                                  Role                  @default(USER)
  avatarUrl                                             String?               @map("avatar_url")
  isActive                                              Boolean               @default(true) @map("is_active")
  emailVerifiedAt                                       DateTime?             @map("email_verified_at") @db.Timestamptz(6)
  lastLoginAt                                           DateTime?             @map("last_login_at") @db.Timestamptz(6)
  createdAt                                             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                                             DateTime?             @map("deleted_at") @db.Timestamptz(6)
  admin_audit_logs                                      admin_audit_logs[]
  ai_prompt_templates                                   ai_prompt_templates[]
  ai_usage_logs                                         ai_usage_logs[]
  authSessions                                          AuthSession[]
  interviewAnswers                                      InterviewAnswer[]
  interview_reports                                     interview_reports[]
  interviewSessions                                     InterviewSession[]
  payments                                              payments[]
  question_audios                                       question_audios[]
  study_plan_analyses                                   study_plan_analyses[]
  system_settings                                       system_settings[]
  uploaded_files_uploaded_files_owner_user_idTousers    uploaded_files[]      @relation("uploaded_files_owner_user_idTousers")
  uploaded_files_uploaded_files_uploader_user_idTousers uploaded_files[]      @relation("uploaded_files_uploader_user_idTousers")
  user_activity_logs                                    user_activity_logs[]
  user_badges                                           user_badges[]
  user_preferences                                      user_preferences?
  profile                                               UserProfile?
  user_subscriptions                                    user_subscriptions[]
  user_weekly_goals                                     user_weekly_goals[]
  voice_recordings                                      voice_recordings[]

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([createdAt], map: "idx_users_created_at")
  @@index([isActive], map: "idx_users_is_active")
  @@index([role], map: "idx_users_role")
  @@map("users")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([expiresAt], map: "idx_auth_sessions_expires_at")
  @@index([userId], map: "idx_auth_sessions_user_id")
  @@map("auth_sessions")
}

model UserProfile {
  id                        String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String                @unique @map("user_id") @db.Uuid
  age                       Int?
  degreeLevel               DegreeLevel           @map("degree_level")
  targetSchool              String                @map("target_school") @db.VarChar(255)
  targetMajor               String                @map("target_major") @db.VarChar(255)
  scholarshipType           String                @map("scholarship_type") @db.VarChar(255)
  hskLevel                  String?               @map("hsk_level") @db.VarChar(50)
  hskkLevel                 String?               @map("hskk_level") @db.VarChar(50)
  ieltsScore                String?               @map("ielts_score") @db.VarChar(50)
  toeflScore                String?               @map("toefl_score") @db.VarChar(50)
  gpa                       String?               @db.VarChar(50)
  awards                    String?
  researchExperience        String?               @map("research_experience")
  extracurricularActivities String?               @map("extracurricular_activities")
  workExperience            String?               @map("work_experience")
  studyPlan                 String                @map("study_plan")
  careerPlan                String?               @map("career_plan")
  strengths                 String?
  weaknesses                String?
  additionalNotes           String?               @map("additional_notes")
  createdAt                 DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  interviewSessions         InterviewSession[]
  study_plan_analyses       study_plan_analyses[]
  user                      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([degreeLevel])
  @@index([targetSchool])
  @@index([targetMajor])
  @@index([degreeLevel], map: "idx_user_profiles_degree_level")
  @@index([targetMajor], map: "idx_user_profiles_target_major")
  @@index([targetSchool], map: "idx_user_profiles_target_school")
  @@map("user_profiles")
}

model School {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @unique @db.VarChar(255)
  nameZh              String?               @map("name_zh") @db.VarChar(255)
  nameEn              String?               @map("name_en") @db.VarChar(255)
  city                String?               @db.VarChar(120)
  province            String?               @db.VarChar(120)
  websiteUrl          String?               @map("website_url")
  description         String?
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  questions           Question[]
  school_majors       school_majors[]
  school_scholarships school_scholarships[]

  @@index([city])
  @@index([province])
  @@index([isActive])
  @@index([city], map: "idx_schools_city")
  @@index([isActive], map: "idx_schools_is_active")
  @@index([province], map: "idx_schools_province")
  @@map("schools")
}

model Major {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String          @db.VarChar(255)
  nameZh        String?         @map("name_zh") @db.VarChar(255)
  nameEn        String?         @map("name_en") @db.VarChar(255)
  degreeLevel   DegreeLevel     @map("degree_level")
  description   String?
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  questions     Question[]
  school_majors school_majors[]

  @@unique([name, degreeLevel])
  @@index([degreeLevel])
  @@index([isActive])
  @@index([degreeLevel], map: "idx_majors_degree_level")
  @@index([isActive], map: "idx_majors_is_active")
  @@map("majors")
}

model Scholarship {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String                @unique @db.VarChar(255)
  code                String?               @db.VarChar(80)
  description         String?
  isActive            Boolean               @default(true) @map("is_active")
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  questions           Question[]
  school_scholarships school_scholarships[]

  @@index([isActive])
  @@index([isActive], map: "idx_scholarships_is_active")
  @@map("scholarships")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Question {
  id                   String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  degreeLevel          DegreeLevel?               @map("degree_level")
  schoolId             String?                    @map("school_id") @db.Uuid
  majorId              String?                    @map("major_id") @db.Uuid
  scholarshipId        String?                    @map("scholarship_id") @db.Uuid
  admissionSeasonId    String?                    @map("admission_season_id") @db.Uuid
  category             QuestionCategory           @default(OTHER)
  difficulty           DifficultyLevel            @default(MEDIUM)
  language             LanguageCode               @default(VI)
  questionText         String                     @map("question_text")
  suggestedAnswerLogic String?                    @map("suggested_answer_logic")
  sampleAnswer         String?                    @map("sample_answer")
  keywords             String?
  commonMistakes       String?                    @map("common_mistakes")
  scoringRubric        Json?                      @map("scoring_rubric")
  isActive             Boolean                    @default(true) @map("is_active")
  createdBy            String?                    @map("created_by") @db.Uuid
  updatedBy            String?                    @map("updated_by") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?                  @map("deleted_at") @db.Timestamptz(6)
  sessionQuestions     InterviewSessionQuestion[]
  question_audios      question_audios[]
  question_tag_links   question_tag_links[]
  major                Major?                     @relation(fields: [majorId], references: [id])
  scholarship          Scholarship?               @relation(fields: [scholarshipId], references: [id])
  school               School?                    @relation(fields: [schoolId], references: [id])

  @@index([degreeLevel])
  @@index([schoolId])
  @@index([majorId])
  @@index([scholarshipId])
  @@index([category])
  @@index([difficulty])
  @@index([language])
  @@index([isActive])
  @@index([category], map: "idx_questions_category")
  @@index([degreeLevel], map: "idx_questions_degree_level")
  @@index([difficulty], map: "idx_questions_difficulty")
  @@index([isActive], map: "idx_questions_is_active")
  @@index([language], map: "idx_questions_language")
  @@index([majorId], map: "idx_questions_major_id")
  @@index([scholarshipId], map: "idx_questions_scholarship_id")
  @@index([schoolId], map: "idx_questions_school_id")
  @@map("questions")
}

model InterviewSession {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                     @map("user_id") @db.Uuid
  profileId         String?                    @map("profile_id") @db.Uuid
  mode              InterviewMode              @default(PRACTICE)
  language          LanguageCode               @default(VI)
  status            InterviewStatus            @default(DRAFT)
  degreeLevel       DegreeLevel?               @map("degree_level")
  targetSchool      String?                    @map("target_school") @db.VarChar(255)
  targetMajor       String?                    @map("target_major") @db.VarChar(255)
  scholarshipType   String?                    @map("scholarship_type") @db.VarChar(255)
  totalQuestions    Int                        @default(0) @map("total_questions")
  answeredQuestions Int                        @default(0) @map("answered_questions")
  totalScore        Decimal?                   @map("total_score") @db.Decimal(5, 2)
  summaryFeedback   String?                    @map("summary_feedback")
  startedAt         DateTime?                  @map("started_at") @db.Timestamptz(6)
  endedAt           DateTime?                  @map("ended_at") @db.Timestamptz(6)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  answers           InterviewAnswer[]
  interview_reports interview_reports?
  sessionQuestions  InterviewSessionQuestion[]
  profile           UserProfile?               @relation(fields: [profileId], references: [id])
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  voice_recordings  voice_recordings[]

  @@index([userId])
  @@index([profileId])
  @@index([status])
  @@index([createdAt])
  @@index([createdAt], map: "idx_interview_sessions_created_at")
  @@index([profileId], map: "idx_interview_sessions_profile_id")
  @@index([status], map: "idx_interview_sessions_status")
  @@index([userId], map: "idx_interview_sessions_user_id")
  @@map("interview_sessions")
}

model InterviewSessionQuestion {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId           String            @map("session_id") @db.Uuid
  questionId          String?           @map("question_id") @db.Uuid
  source              QuestionSource
  orderIndex          Int               @map("order_index")
  questionText        String            @map("question_text")
  category            QuestionCategory  @default(OTHER)
  difficulty          DifficultyLevel   @default(MEDIUM)
  language            LanguageCode      @default(VI)
  aiReason            String?           @map("ai_reason")
  expectedAnswerLogic String?           @map("expected_answer_logic")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  answers             InterviewAnswer[]
  question            Question?         @relation(fields: [questionId], references: [id])
  session             InterviewSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
  @@index([questionId])
  @@index([questionId], map: "idx_interview_session_questions_question_id")
  @@index([sessionId], map: "idx_interview_session_questions_session_id")
  @@map("interview_session_questions")
}

model InterviewAnswer {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId         String                   @map("session_id") @db.Uuid
  sessionQuestionId String                   @map("session_question_id") @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  answerText        String?                  @map("answer_text")
  answerAudioUrl    String?                  @map("answer_audio_url")
  speechToTextRaw   String?                  @map("speech_to_text_raw")
  scoreTotal        Decimal?                 @map("score_total") @db.Decimal(5, 2)
  scoreRelevance    Decimal?                 @map("score_relevance") @db.Decimal(5, 2)
  scoreLogic        Decimal?                 @map("score_logic") @db.Decimal(5, 2)
  scoreSpecificity  Decimal?                 @map("score_specificity") @db.Decimal(5, 2)
  scoreLanguage     Decimal?                 @map("score_language") @db.Decimal(5, 2)
  feedback          String?
  strengths         String?
  weaknesses        String?
  improvedAnswer    String?                  @map("improved_answer")
  aiUsageLogId      String?                  @map("ai_usage_log_id") @db.Uuid
  answeredAt        DateTime                 @default(now()) @map("answered_at") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  session           InterviewSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionQuestion   InterviewSessionQuestion @relation(fields: [sessionQuestionId], references: [id], onDelete: Cascade)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voice_recordings  voice_recordings[]

  @@unique([sessionId, sessionQuestionId])
  @@index([sessionId])
  @@index([userId])
  @@index([scoreTotal])
  @@index([scoreTotal], map: "idx_interview_answers_score_total")
  @@index([sessionId], map: "idx_interview_answers_session_id")
  @@index([userId], map: "idx_interview_answers_user_id")
  @@map("interview_answers")
}

