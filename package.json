{
  "name": "ai-phongvan-monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm --prefix frontend run dev\" \"npm --prefix backend run dev\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "concurrently": "^9.2.1",
    "typescript": "~5.7.0"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express-rate-limit": "^8.5.2",
    "lucide-react": "^1.17.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.50.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "recharts": "^3.8.1"
  }
}
